# Copy to .env.promotion (git-ignored) and point it at your production installation.
# Used by scripts/Promote-Production.ps1; -ProductionPath and -HealthUri override these values.
CLIPROXY_PRODUCTION_PATH=C:\path\to\CLIProxyAPI
# Optional loopback health endpoint of that installation.
# CLIPROXY_HEALTH_URI=http://127.0.0.1:8317/healthz
